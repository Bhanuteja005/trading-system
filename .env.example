# Copy to .env and fill in. .env is gitignored — never commit real values.

# ---- Core -------------------------------------------------------------------
TSYS_ENV=development
TSYS_LOG_LEVEL=INFO
TSYS_TIMEZONE=Asia/Kolkata

# ---- Trading mode -----------------------------------------------------------
# dry_run (default, never contacts the broker) | paper | live
TSYS_MODE=dry_run
# Live trading needs BOTH TSYS_MODE=live and this flag. Startup refuses otherwise.
TSYS_LIVE_CONFIRMED=false

# ---- Broker (OpenAlgo) ------------------------------------------------------
OPENALGO_URL=http://127.0.0.1:5000
OPENALGO_API_KEY=
OPENALGO_STRATEGY=ClaudeTrader

# ---- TradingView ------------------------------------------------------------
TV_CDP_PORT=9222
TV_MAX_QUOTE_AGE_SECONDS=90

# ---- Risk -------------------------------------------------------------------
TSYS_CAPITAL=300000
TSYS_MAX_RISK_PCT=0.01
TSYS_MIN_RISK_PCT=0.0025
TSYS_MIN_RR=2.0
TSYS_MIN_CONFIDENCE=0.65
TSYS_MAX_OPEN_POSITIONS=2
TSYS_MAX_TOTAL_RISK_PCT=0.02
TSYS_DAILY_LOSS_LIMIT=6000
TSYS_DAILY_PROFIT_TARGET=9000
